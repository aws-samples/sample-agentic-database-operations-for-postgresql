# Auto-generated by backend/scripts/setup-env.sh (local development only).
AWS_REGION=us-east-1

# Bedrock Models
AGENT_MODEL_ID=global.anthropic.claude-haiku-5-5
BEDROCK_REGION=us-east-1
# Chat follow-up suggestions (the follow-up pills under an answer). One short model
# call per chat turn on the turn's own model; fail-soft. Set CHAT_FOLLOWUPS=off to
# disable, or pin a cheaper model for it with CHAT_FOLLOWUPS_MODEL_ID.
# CHAT_FOLLOWUPS=on
# CHAT_FOLLOWUPS_MODEL_ID=

# Every physical resource name derives from this prefix. Keep it equal to the deployed
# stack's ResourcePrefix, or the app looks up tables and buckets that do not exist.
RESOURCE_PREFIX=dbops

# S3. Set explicitly because the bucket name carries an account-id suffix that cannot
# be derived from the prefix alone.
REPORTS_S3_BUCKET=

# DynamoDB table names are derived from RESOURCE_PREFIX by tools/resource_names.py.
# Set one of these only to point at a table that does not follow the convention.
# DB_CONFIG_TABLE=

# Cognito Authentication (auto-populated from auth stack)
USER_POOL_ID=
WEB_CLIENT_ID=
M2M_CLIENT_ID=
COGNITO_DOMAIN=
M2M_CLIENT_SECRET=

# CORS — comma-separated list of allowed frontend origins (operator app +
# admin console URLs). Leave blank for local dev (localhost ports allowed).
# Example: https://d111.cloudfront.net,https://d222.cloudfront.net
ALLOWED_ORIGINS=

# VPC Configuration (auto-detected from existing RDS/Aurora PostgreSQL instances)
# If no instances exist, add manually or use Settings > Discover
VPC_ID=
SUBNET_IDS=
SECURITY_GROUP_IDS=

# Notifications (auto-populated from storage stack)
NOTIFICATION_TOPIC_ARN=

# Metrics store (auto-populated from the deployed stack): two DynamoDB tables plus
# CloudWatch custom metrics. IAM only, nothing secret to set.
TIER1_METRICS_TABLE=
TIER2_SCANS_TABLE=

# Discovery role in each target account. Derived from RESOURCE_PREFIX as
# arn:aws:iam::{account_id}:role/<prefix>-discovery; set this only to override that.
# DISCOVERY_ROLE_ARN_TEMPLATE=arn:aws:iam::{account_id}:role/my-role

# ---- Populated after AgentCore deployment (make deploy-all) ----
# AGENT_ENDPOINT=

# AWS Batch (auto-populated from agent stack after deployment)
# BATCH_JOB_QUEUE=
# BATCH_JOB_DEFINITION=
