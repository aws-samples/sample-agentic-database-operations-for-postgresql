pyyaml==6.0.3
# 6.7.5 is the floor that clears the 5.x decode-stream DoS advisories (malformed
# Flate/LZW/RunLength/ASCIIHex streams exhausting RAM, infinite loops on outlines
# and xref chains). Pinned well past it because knowledge_store feeds PdfReader
# operator-uploaded bytes; only PdfReader/.pages/.extract_text() are used, which
# are unchanged across the 5.x -> 6.x boundary.
pypdf==6.21.2
# IAM-signed MCP client for the AgentCore Web Search Gateway connector (docs_agent).
# Only used when WEB_SEARCH_GATEWAY_URL is set; import is guarded so it's optional.
mcp-proxy-for-aws==1.7.0
# In-app JWT signature verification against the Cognito JWKS (defense-in-depth,
# LOG-ONLY phase — utils/auth.py). The [crypto] extra pulls `cryptography` for the
# RS256 verification Cognito uses. Import is guarded: if unavailable, log-only
# verification degrades to a no-op and never blocks a request.
PyJWT[crypto]==2.15.1

